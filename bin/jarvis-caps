#!/usr/bin/env python3
"""jarvis-caps – was kann ich (Jarvis) gerade? Schneller Selbstcheck aller Sinne und Werkzeuge (< 5 s).

  jarvis-caps          kompakte Übersicht (wird beim Start des Gehirns automatisch geladen)
  jarvis-caps --card   als Holo-Karte anzeigen
"""
import concurrent.futures as cf, json, os, shutil, subprocess, sys

H = os.path.expanduser('~')
B = '/data/home/opt/bin/'


def run(cmd, t=4):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=t)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 99, str(e)


def c_cam():
    ok = os.path.exists('/dev/video0') and os.path.exists('/dev/video1')
    qr = shutil.which('zbarimg') is not None
    return ok, 'Front + Rück bereit' + ('' if qr else ', QR-Scanner fehlt') if ok else 'keine Videogeräte'


def c_phone():
    rc, out = run([B + 'adb', 'devices'], 5)
    devs = [l.split()[0] for l in out.splitlines()[1:] if l.strip().endswith('device')]
    try: st = json.load(open(H + '/jarvis/state/phone.json'))
    except Exception: st = {}
    if devs: return True, 'verbunden (%s)' % devs[0]
    return False, 'nicht verbunden' + (' – zuletzt %s' % st['ip'] if st.get('ip') else ' – nie gekoppelt') + ' → jarvis-phone connect / pair-qr'


def c_mic():
    rc, out = run(['pactl', 'get-default-source'])
    return rc == 0 and bool(out), out or 'kein Mikrofon'


def c_net():
    rc, out = run(['nmcli', '-t', '-f', 'ACTIVE,SSID', 'dev', 'wifi'])
    ssid = next((l.split(':', 1)[1] for l in out.splitlines() if l.startswith('yes:')), '')
    return bool(ssid), ssid or 'kein WLAN'


def c_wa():
    if not os.path.exists(B + 'wacli'): return False, 'nicht installiert'
    rc, out = run([B + 'wacli', 'auth', 'status'], 6)
    return 'Authenticated' in out, 'gekoppelt' if 'Authenticated' in out else 'nicht gekoppelt → wacli auth'


def c_google():
    rc, out = run([B + 'gog', 'auth', 'list'], 6)
    ok = '@' in out
    return ok, 'verbunden' if ok else 'nicht angemeldet → gog auth add'


def c_tg():
    ok = os.path.exists(H + '/.config/tg/session.session')
    return ok, 'angemeldet' if ok else 'nicht eingerichtet → tg setup / tg login'


def c_pentest():
    import shutil
    core = ['nmap', 'nuclei', 'ffuf', 'sqlmap', 'hydra', 'john']
    have = [t for t in core if shutil.which(t) or os.path.exists('/data/home/opt/bin/' + t)]
    return len(have) >= 5, '%d/%d Kerntools (jarvis-pentest tools)' % (len(have), len(core))


def c_kde():
    if not shutil.which('kdeconnect-cli'): return False, 'nicht installiert'
    rc, out = run(['kdeconnect-cli', '-a', '--name-only'], 5)
    return bool(out.strip()), ('erreichbar: ' + out.strip().replace('\n', ', ')) if out.strip() else 'kein Gerät erreichbar'


CHECKS = [('Kameras', c_cam), ('Handy (adb)', c_phone), ('Mikrofon', c_mic), ('WLAN', c_net), ('WhatsApp', c_wa),
          ('Google', c_google), ('Telegram', c_tg), ('KDE Connect', c_kde), ('Pentest', c_pentest)]


def main():
    with cf.ThreadPoolExecutor(len(CHECKS)) as ex:
        res = list(ex.map(lambda c: (c[0],) + _safe(c[1]), CHECKS))
    if '--card' in sys.argv:
        card = {'type': 'list', 'icon': '🧭', 'title': 'Meine Fähigkeiten – Status',
                'items': [{'title': n, 'sub': t, 'badge': 'bereit' if ok else 'aus', 'unread': ok, 'icon': '✅' if ok else '⚪'} for n, ok, t in res]}
        subprocess.run([H + '/jarvis/bin/jarvis-show', '--id', 'caps', '-'], input=json.dumps(card), text=True, capture_output=True)
    for n, ok, t in res:
        print('%s %-12s %s' % ('✓' if ok else '✗', n + ':', t))


def _safe(f):
    try: return f()
    except Exception as e: return False, 'Fehler: %s' % e


if __name__ == '__main__':
    main()
