#!/bin/sh
# jarvis-ctl <json>   z.B. jarvis-ctl '{"cmd":"snapshot","path":"/tmp/x.png"}'  |  jarvis-ctl '{"cmd":"health"}'
python3 -c "
import socket,sys,os
s=socket.socket(socket.AF_UNIX); s.settimeout(10); s.connect('/run/user/%d/jarvis.sock'%os.getuid()); s.sendall(sys.argv[1].encode()+b'\n')
d=b''
while not d.endswith(b'\n'):
    c=s.recv(65536)
    if not c: break
    d+=c
print(d.decode().strip())" "$1"
